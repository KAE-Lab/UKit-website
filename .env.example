# Variables d'environnement du site. Copier en `.env` (ignore par git) pour le developpement.
#
# L'adresse publique du site, sans barre finale : elle sert aux balises Open Graph des pages
# (`%VITE_SITE_URL%` dans le HTML). `.env.production` la porte pour le build de production et EST
# versionne : c'est une adresse publique, pas un secret.
VITE_SITE_URL=http://localhost:5173
